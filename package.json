{
  "name": "nexotv-monorepo",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm --filter backend dev\" \"pnpm --filter frontend dev\"",
    "build": "pnpm --filter frontend build && pnpm --filter backend build",
    "start": "pnpm --filter backend start"
  },
  "devDependencies": {
    "concurrently": "^8.0.0",
    "prisma": "8.0.0-rc.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ],
    "overrides": {
      "@effect/platform-bun": "4.0.0-rc.112",
      "@effect/platform-node": "4.0.0-rc.112",
      "@effect/platform-node-shared": "4.0.0-rc.112",
      "@effect/sql-d1": "4.0.0-rc.112",
      "@effect/sql-pg": "4.0.0-rc.112",
      "@effect/vitest": "4.0.0-rc.112",
      "effect": "4.0.0-rc.112"
    }
  },
  "dependencies": {
    "@prisma/composer": "0.16.0",
    "@prisma/composer-prisma-cloud": "0.16.0",
    "alchemy": "2.0.0-beta.74",
    "effect": "4.0.0-rc.112"
  }
}
